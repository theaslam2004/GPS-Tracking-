# =======================================================================
# Fleetly GPS — Production Environment Configuration Template
# Copy this file to '.env' and modify values before launching the server.
# =======================================================================

# ── LISTEN PORTS ──
# Web portal interface (default: 3000)
PORT=3000

# GPS Tracker hardware device TCP port (default: 8080)
TCP_PORT=8080

# ── DATABASE PERSISTENCE ──
# MongoDB Connection URI for production (default: mongodb://localhost:27017/fleetly)
MONGODB_URI=mongodb://localhost:27017/fleetly

# Absolute or relative path to the fallback database file (default: ./data.json)
DATA_FILE_PATH=./data.json

# ── SECURITY & PASSWORDS ──
# Secret key used for symmetric encryption of customer credentials in data.json.
# WARNING: Keep this private and change this key for your production server!
ENCRYPTION_KEY=fleetly-gps-default-key-change-in-prod-2026

# Session secret used to sign Express session ID cookies (change this in production!)
SESSION_SECRET=fleetly-gps-session-super-secure-key-2026

# ── SMTP ALERT EMAILS ──
# To activate SMTP alert emails, set SMTP_ENABLED=true and configure your server details.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Fleetly GPS Alerts <your_gmail@gmail.com>

# ── SMS TRANSACTIONAL ALERTS ──
# To activate real mobile SMS alerts (Fast2SMS), set SMS_ENABLED=true and paste your Dev API Key.
SMS_ENABLED=false
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
