<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6C63FF</item>
        <item name="colorPrimaryDark">#0f0f1a</item>
        <item name="colorAccent">#3ECFCF</item>
        <item name="android:windowBackground">#0f0f1a</item>
    </style>

    <!-- Launch theme - shown before the WebView loads -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#0f0f1a</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
